{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BillingSourceSlotOverwrite",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::gig-remittance-raw-prod/billing-sources/*"
    },
    {
      "Sid": "BillingUpdateWrites",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::gig-remittance-raw-prod/billing-updates/*"
    },
    {
      "Sid": "CarrierSourceUploads",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::gig-remittance-raw-prod/carrier=*"
    }
  ]
}
